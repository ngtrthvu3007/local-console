{
  "name": "localconsole",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
